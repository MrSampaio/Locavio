    "Adicione seu primeiro imóvel para\ncomeçar a gerenciar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Add your first property to\nstart managing it."
          }
        }
